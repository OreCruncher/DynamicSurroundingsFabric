// The cinematic aurora on a winter night, at each quality, against the realistic style (the default) and with auroras
// off; the same scene as aurora.json, and one looking nearly straight up, where ribbons and their curls often pass.
// Every night has one (chance 100); the time is fixed, so every run has the same night's aurora. See README.md for the
// format.
{
  "world": "bench",
  "seed": 20261030,
  "setup": [
    "gamemode creative",
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "gamerule spawn_mobs false"
  ],
  // What the GPU draws scales with the pixels: the same size for every run to compare
  "video": {"width": 1920, "height": 1080, "vsync": false, "maxFps": 260},
  "warmup": 15,
  "record": 60,
  "repeats": 2,
  "settingSets": {
    "tonight": {"auroraOptions.chance": 100},
    "realistic": {"auroraOptions.style": "REALISTIC", "auroraOptions.realistic.quality": "FANCY"},
    "cinematic": {"auroraOptions.style": "CINEMATIC"}
  },
  "scenes": {
    "aurora": {
      "biome": "minecraft:ice_spikes",
      "yaw": 180,
      "pitch": -35,
      // Up above the spikes and the clouds, on a barrier, for the whole of the sky: on the ground a spike or a cloud
      // could hide much of the aurora, and how much it covers is what it costs
      "commands": [
        "time set 18000",
        "weather clear",
        "season set mid_winter",
        "tp @s ~ 245 ~",
        "setblock ~ ~-1 ~ barrier"
      ],
      "profile": "general"
    },
    "overhead": {
      "biome": "minecraft:ice_spikes",
      "yaw": 180,
      "pitch": -80,
      "commands": [
        "time set 18000",
        "weather clear",
        "season set mid_winter",
        "tp @s ~ 245 ~",
        "setblock ~ ~-1 ~ barrier"
      ],
      "profile": "general"
    }
  },
  "runs": [
    {"label": "realistic-fancy", "scene": "aurora", "use": ["tonight", "realistic"]},
    {"label": "cinematic-fancy", "scene": "aurora", "use": ["tonight", "cinematic"],
      "settings": {"auroraOptions.cinematic.quality": "FANCY"}},
    {"label": "cinematic-fast", "scene": "aurora", "use": ["tonight", "cinematic"],
      "settings": {"auroraOptions.cinematic.quality": "FAST"}},
    {"label": "cinematic-overhead", "scene": "overhead", "use": ["tonight", "cinematic"],
      "settings": {"auroraOptions.cinematic.quality": "FANCY"}},
    {"label": "aurora-off", "scene": "aurora", "use": "tonight", "settings": {"auroraOptions.enableAuroras": false}}
  ]
}
