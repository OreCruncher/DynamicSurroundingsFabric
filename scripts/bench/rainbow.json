// The rainbow's cost: held at full strength with its secondary bow, with the primary alone, and off, in the same scene.
// The pass runs over the whole screen, but a pixel further than 56 degrees from the point opposite the sun stops after
// one dot product, so what it costs follows how much of the screen is near the bow: the scene faces the bow squarely.
// See README.md for the format.
{
  "world": "bench",
  "seed": 20261030,
  "setup": [
    "gamemode creative",
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "gamerule spawn_mobs false"
  ],
  // What the GPU draws scales with the pixels: the same size for every run to compare
  "video": {"width": 1920, "height": 1080, "vsync": false, "maxFps": 260},
  "warmup": 15,
  "record": 60,
  "repeats": 2,
  "settingSets": {
    "off": {"weatherOptions.sky.enableRainbows": false},
    "realistic": {"weatherOptions.sky.skyStyle": "REALISTIC"}
  },
  // A beach (open and flat), which no other scenario builds on. Late afternoon, the sun 20 degrees up in the west
  // (time 11500): the point opposite it is 20 degrees below the horizon in the east, and the primary bow's top 22
  // degrees above it. Facing east (yaw -90), looking a little up. The clouds are held off so none hides part of the
  // bow on one run and not another
  "scenes": {
    "both": {
      "biome": "minecraft:beach",
      "yaw": -90,
      "pitch": -10,
      "commands": ["time set 11500", "weather clear", "dsweather clouds 0", "dsweather rainbow 100"],
      "profile": "general"
    },
    "primary": {
      "biome": "minecraft:beach",
      "yaw": -90,
      "pitch": -10,
      "commands": ["time set 11500", "weather clear", "dsweather clouds 0", "dsweather rainbow 100 primary"],
      "profile": "general"
    }
  },
  "runs": [
    {"label": "rainbow-both", "scene": "both", "use": "realistic"},
    {"label": "rainbow-primary", "scene": "primary", "use": "realistic"},
    {"label": "rainbow-blocky", "scene": "both", "settings": {"weatherOptions.sky.skyStyle": "BLOCKY"}},
    {"label": "rainbow-off", "scene": "both", "use": "off"}
  ]
}
