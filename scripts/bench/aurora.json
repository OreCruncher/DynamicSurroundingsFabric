// The aurora on a winter night: the realistic style at each quality, the classic one with its default curtains and
// with one, and off. Every night has one (chance 100); the time is fixed, so every run has the same night's aurora.
// Each run names its style, as the default is the realistic one. See README.md for the format.
{
  "world": "bench",
  "seed": 20261030,
  "setup": [
    "gamemode creative",
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "gamerule spawn_mobs false"
  ],
  // What the GPU draws scales with the pixels: the same size for every run to compare
  "video": {"width": 1920, "height": 1080, "vsync": false, "maxFps": 260},
  "warmup": 15,
  "record": 60,
  "repeats": 2,
  "settingSets": {
    "tonight": {"auroraOptions.chance": 100},
    "realistic": {"auroraOptions.style": "REALISTIC"},
    "classic": {"auroraOptions.style": "CLASSIC"}
  },
  "scenes": {
    "aurora": {
      "biome": "minecraft:ice_spikes",
      // Auroras lie north (-Z): the classic within 30 degrees, the realistic along magnetic east-west
      "yaw": 180,
      "pitch": -35,
      // Up above the spikes and the clouds, on a barrier, for the whole of the northern sky: on the ground a spike or a
      // cloud could hide much of the aurora, and how much it covers is what it costs
      "commands": [
        "time set 18000",
        "weather clear",
        "season set mid_winter",
        "tp @s ~ 245 ~",
        "setblock ~ ~-1 ~ barrier"
      ],
      "profile": "general"
    }
  },
  "runs": [
    {"label": "realistic-fancy", "scene": "aurora", "use": ["tonight", "realistic"],
      "settings": {"auroraOptions.realistic.quality": "FANCY"}},
    {"label": "realistic-fast", "scene": "aurora", "use": ["tonight", "realistic"],
      "settings": {"auroraOptions.realistic.quality": "FAST"}},
    {"label": "classic-default", "scene": "aurora", "use": ["tonight", "classic"]},
    {"label": "classic-bands1", "scene": "aurora", "use": ["tonight", "classic"],
      "settings": {"auroraOptions.classic.maxBands": 1}},
    {"label": "aurora-off", "scene": "aurora", "use": "tonight", "settings": {"auroraOptions.enableAuroras": false}}
  ]
}
