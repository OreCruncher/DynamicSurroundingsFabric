// Firespouts (WorldActorHandler, Firespout, FirespoutFlame): summoned with /dsactor as the warm-up starts, from the
// middle of a lava lake built over a desert, walled so it doesn't spill: the bench finds overworld biomes only, and a
// firespout needs nothing of the Nether but open lava. Its lava is below 100, where a firespout looks down from (no roof
// is needed). Built 160 blocks west of the scene's place, so it roofs no scene there (see README.md, "Raised stages").
// At night, so its light shows. A summoned one has a
// random size and path, so compare with --spread. Two, as a lake might show, and six, far more than ever start
// naturally. One lives 40 seconds at least, and takes 10 to grow: the warm-up and the recording fit in that, but it can
// live 90, so the six have a lake of their own, over plains, or the next run's two find them still there (the off runs
// clear them). Facing east, downwind on the bench world's day, as in dust-devils.json, and a little up, as they are
// tall. See README.md.
{
  "world": "bench",
  "seed": 20261030,
  "setup": [
    "gamemode creative",
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "gamerule spawn_mobs false"
  ],
  "video": {
    "width": 1920,
    "height": 1080,
    "vsync": false,
    "maxFps": 260
  },
  "warmup": 12,
  "record": 25,
  "repeats": 2,
  "scenes": {
    "firespouts": {
      "biome": "minecraft:desert",
      "yaw": -90,
      "pitch": -10,
      "commands": [
        "time set 18000",
        "weather clear",
        "tp @s ~-160 90 ~",
        "fill ~-65 ~-2 ~-65 ~65 ~-2 ~65 netherrack",
        "fill ~-65 ~-1 ~-65 ~65 ~-1 ~65 netherrack",
        "fill ~-64 ~-1 ~-64 ~64 ~-1 ~64 lava",
        "setblock ~ ~-1 ~ netherrack"
      ],
      "settledCommands": [
        "dsactor firespout",
        "dsactor firespout"
      ],
      "profile": "general"
    },
    "firespouts-plains": {
      "biome": "minecraft:plains",
      "yaw": -90,
      "pitch": -10,
      "commands": [
        "time set 18000",
        "weather clear",
        "tp @s ~-160 90 ~",
        "fill ~-65 ~-2 ~-65 ~65 ~-2 ~65 netherrack",
        "fill ~-65 ~-1 ~-65 ~65 ~-1 ~65 netherrack",
        "fill ~-64 ~-1 ~-64 ~64 ~-1 ~64 lava",
        "setblock ~ ~-1 ~ netherrack"
      ],
      "settledCommands": [
        "dsactor firespout",
        "dsactor firespout",
        "dsactor firespout",
        "dsactor firespout",
        "dsactor firespout",
        "dsactor firespout"
      ],
      "profile": "general"
    }
  },
  "runs": [
    {
      "label": "firespouts-2",
      "scene": "firespouts",
      "settings": {
        "worldActorOptions.enableFirespouts": true
      }
    },
    {
      "label": "firespouts-6",
      "scene": "firespouts-plains",
      "settings": {
        "worldActorOptions.enableFirespouts": true
      }
    },
    {
      "label": "firespouts-off",
      "scene": "firespouts",
      "settings": {
        "worldActorOptions.enableFirespouts": false
      }
    }
  ]
}
