// Constants and functions for scripts (see lib/scripting/ScriptDefinitions and config/ScriptDefinitionLoader). Scripts
// use them under "def.": def.APPARITION_CHANCE, def.isHalloween(). Names are written here without it.
// - "constants": true or false, a number, or a string; every script sees them
// - "biome": expressions for biome rules (biomeSelector), of biome traits such as SPOOKY
// - "conditions": expressions for every other script (conditions, chances), of diurnal, weather, player and the rest
// A function takes no arguments, may use the constants and the other functions of its section, and nothing defined in
// code can be replaced. Modpacks add their own in config/dsurround/configs/<namespace>/scripts.json or a resource pack;
// a later file's definition of a name replaces ours.
{
  "constants": {
    "APPARITION_CHANCE": 0.1,
    "SWAMP_APPARITION_CHANCE": 0.015,
    "HALLOWEEN_FACTOR": 3
  },
  "biome": {
    "isHaunted": "SPOOKY && !UNDERGROUND"
  },
  "conditions": {
    "_weather": "Fair is not raining; mild is fair and warm enough that water doesn't freeze (insects, frogs)",
    "isFairDay": "weather.isNotRaining() && diurnal.isDay()",
    "isFairNight": "weather.isNotRaining() && diurnal.isNight()",
    "_daylight": "Not night: the day with its sunrise and sunset, for what sings at dawn and dusk",
    "isFairDaylight": "weather.isNotRaining() && !diurnal.isNight()",
    "isMild": "weather.isNotRaining() && !weather.canWaterFreeze()",
    "isMildDay": "def.isMild() && diurnal.isDay()",
    "isMildNight": "def.isMild() && diurnal.isNight()",
    "isScaryNight": "diurnal.isNight() && global.allowScary()",
    "isOutInVillage": "state.isInVillage() && !state.isInside()",
    "isHalloween": "platform.isCurrentDateInRangeOf(10, 31, 7)",
    "halloweenFactor": "def.isHalloween() ? def.HALLOWEEN_FACTOR : 1"
  }
}
