{
  "schemaVersion": 1,
  "id": "dsurround",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "issues": "${mod_issues_url}",
    "homepage": "${mod_homepage_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/dsurround/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "org.orecruncher.fabric.FabricMod::initialize"
    ],
    "client": [
      "org.orecruncher.fabric.FabricMod::initializeClient"
    ],
    "modmenu": [
      "org.orecruncher.fabric.ModConfigMenu"
    ],
    "voicechat": [
      "org.orecruncher.dsurround.runtime.audio.voicechat.VoiceChatPlugin"
    ]
  },
  "mixins": [
    "dsurround.mixins.json",
    "dsurround.mixins.fabric.json"
  ],
  "accessWidener": "dsurround.classtweaker",
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "architectury": ">=22.0.5",
    "fabric-api": "*"
  },
  "suggests": {
    "cloth-config": ">=26.3.159"
  },
  "custom": {
    "modmenu": {
      "links": {
        "dsurround.mod.link.sources": "https://github.com/OreCruncher/DynamicSurroundingsFabric",
        "dsurround.mod.link.credits": "https://github.com/OreCruncher/DynamicSurroundingsFabric/blob/main/CREDITS.md"
      }
    }
  }
}
